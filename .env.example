# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# AI Mode (optional). URL of the routing proxy Worker. When unset, AI Mode uses the
# free offline deterministic engine only. When set, it uses the LLM router and falls
# back to deterministic on any error. See docs/ai-mode/proxy.md.
VITE_AI_PROXY_URL=https://your-ai-proxy.workers.dev
